# Local dev .env template. Copy to .env (which IS gitignored) and fill in.
# `docker compose up` uses ${VAR:?msg} for required vars — compose fails loudly if these are unset.
#
# SECURITY: NEVER paste real credentials into this file. It is tracked
# (`!.env.example` in .gitignore). Real values go in `.env` only.

# --- Local-dev S3 (MinIO) ---
# Use minioadmin/minioadmin for local; OVERRIDE in prod (compose checks for the literal "minioadmin"
# in production deploys — see app/config.py once Sprint 1 lands).
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ccdp-blobs

# --- Snowflake (firm cloud — required for Sprint 1+) ---
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=CCDP_WH
# SNOWFLAKE_DATABASE=CCDP
# SNOWFLAKE_SCHEMA=PUBLIC

# --- AWS Bedrock ---
# Our pydantic-settings prefix is CCDP_ (see src/cc_distribution_parser/config.py).
# boto3 reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the process env directly.
# CCDP_AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME

# --- SQLite ops state ---
SQLITE_OPS_PATH=/data/ops.db
