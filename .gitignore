# Claude Code tooling — exclude entirely from public repo
.claude/
CLAUDE.md
CLAUDE.local.md
mcp.json
overrides.md

# Standard Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Secrets — never commit
.env
.env.*
# Re-include the template
!.env.example
.credentials.json
*.key
*.pem
secrets/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Project-local scratch / data
data/*
scratch/
*.pdf
*.docx
# Re-include the golden-eval corpus (PDFs + JSON ground truth) so CI eval is reproducible.
# Must un-ignore the directory FIRST, then the files, then re-override *.pdf for this scope.
!data/golden_eval/
!data/golden_eval/*.pdf
!data/golden_eval/*.json
!data/golden_eval/*.txt

# Local SQLite ops state — never commit
.ccdp-ops.sqlite
*.ccdp-ops.sqlite

# Project-local wiki runtime (drift reports + raw research notes are runtime state)
wiki/raw/
drift-reports/
